<Window x:Class="CoverflowAltTab.Host.Debug.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoverflowAltTab Debug"
        Width="760"
        Height="640"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14"
                CornerRadius="12"
                Background="#FFF6F7F9"
                BorderBrush="#FFD8DDE5"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="CoverflowAltTab Debug Window"
                           FontSize="20"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0"
                           Text="Global hotkey: Ctrl + Shift + Space"
                           Foreground="#FF475467" />
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="1"
                     Margin="0,14,0,14"
                     Columns="4">
            <Border Margin="0,0,12,0" Padding="12" Background="#FFF9FAFB" BorderBrush="#FFE4E7EC" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="App Status" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding AppStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,12,0" Padding="12" Background="#FFF9FAFB" BorderBrush="#FFE4E7EC" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Hotkey" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding HotkeyStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Margin="0,0,12,0" Padding="12" Background="#FFF9FAFB" BorderBrush="#FFE4E7EC" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Session" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding SessionStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Padding="12" Background="#FFF9FAFB" BorderBrush="#FFE4E7EC" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Last Action" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding LastAction}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2"
                Margin="0,0,0,14"
                Padding="12"
                CornerRadius="12"
                Background="#FFF9FAFB"
                BorderBrush="#FFE4E7EC"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="Overlay renderer" FontWeight="SemiBold" />
                    <ComboBox Margin="0,6,0,0"
                              Width="200"
                              ItemsSource="{Binding AvailableRendererIds}"
                              SelectedItem="{Binding SelectedRendererId}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Animation" FontWeight="SemiBold" />
                    <ComboBox Margin="0,6,0,0"
                              Width="200"
                              ItemsSource="{Binding AvailableAnimationIds}"
                              SelectedItem="{Binding SelectedAnimationId}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="0,0,0,14"
                Padding="0"
                BorderBrush="#FFE4E7EC"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FFF9FAFB" Padding="12" CornerRadius="12,12,0,0">
                    <TextBlock Text="Extensions"
                               FontWeight="SemiBold" />
                </Border>
                <ListView Grid.Row="1"
                          ItemsSource="{Binding Extensions}"
                          BorderThickness="0"
                          MinHeight="140"
                          MaxHeight="180">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="80" Header="Status" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Width="170" Header="Name" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Width="70" Header="Version" DisplayMemberBinding="{Binding Version}" />
                            <GridViewColumn Width="220" Header="Feature" DisplayMemberBinding="{Binding Feature}" />
                            <GridViewColumn Width="110" Header="Contrib" DisplayMemberBinding="{Binding Contributions}" />
                            <GridViewColumn Width="140" Header="Message" DisplayMemberBinding="{Binding Message}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Padding="0"
                BorderBrush="#FFE4E7EC"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FFF9FAFB" Padding="12" CornerRadius="12,12,0,0">
                    <TextBlock Text="Recent Global Key Events"
                               FontWeight="SemiBold" />
                </Border>
                <ListView Grid.Row="1"
                          ItemsSource="{Binding RecentKeys}"
                          BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="120" Header="Time" DisplayMemberBinding="{Binding Timestamp}" />
                            <GridViewColumn Width="120" Header="Type" DisplayMemberBinding="{Binding Kind}" />
                            <GridViewColumn Width="420" Header="Keys" DisplayMemberBinding="{Binding Keys}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>
