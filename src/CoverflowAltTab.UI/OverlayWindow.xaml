<Window x:Class="CoverflowAltTab.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:motion="clr-namespace:CoverflowAltTab.UI.Motion"
        Title="CoverflowAltTab Overlay"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="CoverflowSurfaceVisibilityStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesFreeformLayout}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ListSurfaceVisibilityStyle" TargetType="ItemsControl">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsesFreeformLayout}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border MinWidth="420"
            Background="#EA141414"
            BorderBrush="#FF343434"
            BorderThickness="1"
            CornerRadius="20"
            Padding="18">
        <StackPanel>
            <TextBlock Text="{Binding HeaderTitle}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="White" />
            <TextBlock Text="{Binding HeaderSubtitle}"
                       Margin="0,4,0,12"
                       Foreground="#FFC9C9C9"
                       FontSize="11" />
            <Border x:Name="PreviewHost"
                    Height="210"
                    Margin="0,0,0,14"
                    Background="#10000000"
                    BorderBrush="#223A3A3A"
                    BorderThickness="1"
                    CornerRadius="16"
                    SnapsToDevicePixels="True"
                    ClipToBounds="True">
                <Grid>
                    <Rectangle RadiusX="16"
                               RadiusY="16">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#06000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="0.25" />
                                <GradientStop Color="#66000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="Selected window preview"
                               Margin="12"
                               VerticalAlignment="Top"
                               Foreground="#88FFFFFF"
                               FontSize="11" />
                    <Border VerticalAlignment="Bottom"
                            Height="42"
                            Background="#66000000" />
                </Grid>
            </Border>
            <Border Width="{Binding StageWidth}"
                    Height="{Binding StageHeight}"
                    Margin="0,0,0,14"
                    Background="#0AFFFFFF"
                    BorderBrush="#142D2D2D"
                    BorderThickness="1"
                    CornerRadius="18"
                    SnapsToDevicePixels="True"
                    ClipToBounds="True"
                    Style="{StaticResource CoverflowSurfaceVisibilityStyle}">
                <Grid>
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Width="240"
                            Height="120"
                            Margin="0,-40,0,0"
                            CornerRadius="120"
                            Opacity="0.16">
                        <Border.Background>
                            <RadialGradientBrush GradientOrigin="0.5,0.5">
                                <GradientStop Color="#FF50A7FF" Offset="0" />
                                <GradientStop Color="#0050A7FF" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Rectangle HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Width="700"
                               Height="72"
                               Margin="0,0,0,6"
                               Opacity="0.18">
                        <Rectangle.Fill>
                            <RadialGradientBrush GradientOrigin="0.5,0.4">
                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <ItemsControl ItemsSource="{Binding Windows}"
                                  Width="{Binding StageWidth}"
                                  Height="{Binding StageHeight}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="motion:MotionAnimator.AnimatedLeft" Value="{Binding X}" />
                                <Setter Property="motion:MotionAnimator.AnimatedTop" Value="{Binding Y}" />
                                <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        Padding="16"
                                        CornerRadius="16"
                                        RenderTransformOrigin="0.5,0.5"
                                        motion:MotionAnimator.AnimatedScale="{Binding Scale}"
                                        motion:MotionAnimator.AnimatedSkewY="{Binding Rotation}"
                                        motion:MotionAnimator.AnimatedOpacity="{Binding Opacity}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF404040" Offset="0" />
                                                        <GradientStop Color="#FF2C2C2C" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="BorderBrush" Value="#223B3B3B" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="28"
                                                                      Color="#CC000000"
                                                                      Direction="270"
                                                                      ShadowDepth="12"
                                                                      Opacity="0.55" />
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FF2482C8" Offset="0" />
                                                                <GradientStop Color="#FF0D5F9A" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="BorderBrush" Value="#66C6E4FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Border Height="34"
                                                VerticalAlignment="Top"
                                                CornerRadius="10"
                                                Background="#14FFFFFF" />
                                        <StackPanel VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="White"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Margin="0,8,0,0"
                                                       Foreground="#E0F0F0F0"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Windows}"
                          Width="388"
                          Style="{StaticResource ListSurfaceVisibilityStyle}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="10"
                                CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#22FFFFFF" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#FF0E639C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           Foreground="White"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           Foreground="#FFDADADA"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="2,2,0,0"
                       Foreground="#88FFFFFF"
                       FontSize="11"
                       Text="Tab / Shift+Tab to navigate  |  Enter to switch  |  Esc or click outside to close" />
        </StackPanel>
    </Border>
</Window>
